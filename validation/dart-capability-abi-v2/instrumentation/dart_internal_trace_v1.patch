+#pragma once
+// Isolated diagnostic extension only. No changes to existing DART class layout.
+#include <cstddef>
+#include <cstdint>
+namespace dart { namespace external { namespace ode { namespace trace {
+struct Config { bool enabled=false; std::uint64_t first=0,last=0; std::size_t records=4096,values=262144; const char* run=""; const char* world=""; };
+bool Configure(const Config&) noexcept;
+void InitializeEnvironment() noexcept;
+bool Active() noexcept;
+void BeginStep(const void*, const char*, int, double, double) noexcept;
+void EndStep(bool interrupted=false) noexcept;
+struct StepScope { int exceptions; bool opened; StepScope(const void*,const char*,int,double,double) noexcept; ~StepScope() noexcept; };
+void BeginAssembly(std::size_t,const char*) noexcept;
+void EndAssembly() noexcept;
+void SetRow(int,int,int) noexcept;
+void Emit(const char*,const char*,const char*,const double*,std::size_t,int=-1,int=-1) noexcept;
+void Integers(const char*,const char*,const int*,std::size_t) noexcept;
+void Scalar(const char*,const char*,double) noexcept;
+void Matrix(const char*,const char*,const double*,int,int) noexcept;
+bool FlushExclusive(const char*) noexcept;
+void FinishWorld(const void*) noexcept;
+struct Status { std::size_t records,values,steps,assemblies; unsigned faults; bool enabled,active; };
+Status GetStatus() noexcept;
+}}}}
