+#include "internal_trace.h"
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <fcntl.h>
+#include <iomanip>
+#include <limits>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <unistd.h>
+#include <vector>
+namespace dart { namespace external { namespace ode { namespace trace {
+namespace {
+struct Record { char kind[48],source[80],identity[128]; std::uint64_t step,assembly; int row,col; std::size_t offset,count; };
+struct State { Config cfg; char run[128]{},world[128]{}; std::vector<Record> records;std::vector<double> data;std::size_t used=0,filled=0,steps=0,assemblies=0;std::uint64_t lastStep=0;std::atomic<unsigned> faults{0};std::thread::id owner; const void* worldPtr=nullptr;bool enabled=false; };
+State st;
+struct Context { bool active=false;std::uint64_t step=0,assembly=0;int row=-1,col=-1;const void* world=nullptr; };
+thread_local Context ctx;
+std::once_flag environmentChecked;
+enum {Overflow=1,WrongThread=2,Truncated=4,Interrupted=8,ConfigError=16,IoError=32,Nested=64,IdentityMismatch=128};
+bool Owner() noexcept { if(std::this_thread::get_id()==st.owner)return true;st.faults.fetch_or(WrongThread);return false; }
+void Str(char* dest,std::size_t n,const char* src) noexcept { if(!src)src="";std::size_t l=std::strlen(src);if(l>=n)st.faults.fetch_or(Truncated);std::memcpy(dest,src,std::min(l,n-1));dest[std::min(l,n-1)]=0; }
+std::string Json(const char* s){std::ostringstream o;o<<'"';for(const unsigned char* p=reinterpret_cast<const unsigned char*>(s);*p;++p){if(*p=='"'||*p=='\\')o<<'\\'<<char(*p);else if(*p<32)o<<"\\u"<<std::hex<<std::setw(4)<<std::setfill('0')<<int(*p);else o<<char(*p);}o<<'"';return o.str();}
+bool Parse(const char* name,std::uint64_t& n){const char* s=std::getenv(name);if(!s||!*s||*s=='-')return false;char* e=nullptr;errno=0;n=std::strtoull(s,&e,10);return !errno&&e&&!*e;}
+}
+bool Configure(const Config& c) noexcept {
+ if(ctx.active|| (st.enabled&&!Owner()))return false;
+ st.enabled=false;st.faults.store(0);ctx=Context{};
+ st.used=st.filled=st.steps=st.assemblies=0;st.worldPtr=nullptr;st.lastStep=0;st.owner=std::this_thread::get_id();
+ if(!c.enabled){st.records.clear();st.data.clear();return true;}
+ if(!c.first||c.last<c.first||c.last-c.first>4||!c.records||c.records>65536||!c.values||c.values>1048576||!c.run||!*c.run||!c.world||!*c.world){st.faults.fetch_or(ConfigError);return false;}
+ try {st.records.resize(c.records);st.data.resize(c.values);}catch(...){st.faults.fetch_or(ConfigError);return false;}
+ st.cfg=c;Str(st.run,sizeof(st.run),c.run);Str(st.world,sizeof(st.world),c.world);st.enabled=true;return true;
+}
+void InitializeEnvironment() noexcept {
+ try { std::call_once(environmentChecked, [] {
+ const char* e=std::getenv("DART_INTERNAL_TRACE_V1");if(!e||std::strcmp(e,"1"))return;
+ Config c;c.enabled=true;c.run=std::getenv("DART_TRACE_RUN_ID");c.world=std::getenv("DART_TRACE_WORLD");
+ if(!Parse("DART_TRACE_FIRST_FRAME",c.first)||!Parse("DART_TRACE_LAST_FRAME",c.last)){st.faults.fetch_or(ConfigError);return;}
+ Configure(c);
+ }); } catch(...) {st.faults.fetch_or(ConfigError);}
+}
+bool Active() noexcept{return st.enabled&&ctx.active;}
+void Emit(const char* kind,const char* source,const char* identity,const double* data,std::size_t n,int row,int col) noexcept {
+ if(!Active()||!Owner())return;
+ if((n&&!data)||st.used>=st.records.size()||n>st.data.size()-st.filled){st.faults.fetch_or(Overflow);return;}
+ Record& r=st.records[st.used++];Str(r.kind,sizeof(r.kind),kind);Str(r.source,sizeof(r.source),source);Str(r.identity,sizeof(r.identity),identity);
+ r.step=ctx.step;r.assembly=ctx.assembly;r.row=row<0?ctx.row:row;r.col=col<0?ctx.col:col;r.offset=st.filled;r.count=n;
+ if(n && data!=st.data.data()+st.filled) { std::memcpy(st.data.data()+st.filled,data,n*sizeof(double)); }
+ st.filled+=n;
+}
+void Scalar(const char* k,const char* src,double v) noexcept {Emit(k,src,"",&v,1);}
+void Integers(const char* k,const char* src,const int* values,std::size_t n) noexcept {
+ if(!Active()||!Owner())return;
+ if((n&&!values)||st.used>=st.records.size()||n>st.data.size()-st.filled){st.faults.fetch_or(Overflow);return;}
+ std::size_t offset=st.filled;for(std::size_t i=0;i<n;++i)st.data[offset+i]=values[i];
+ // Source aliases our preallocated arena; Emit uses memmove-safe identical pointer.
+ Emit(k,src,"",st.data.data()+offset,n);
+}
+void Matrix(const char* k,const char* src,const double* v,int n,int stride) noexcept {
+ if(!Active())return;
+ if(n<0||stride<n){st.faults.fetch_or(ConfigError);return;}
+ for(int i=0;i<n;++i)Emit(k,src,"",v+std::size_t(i)*stride,n,i,0);
+}
+void BeginStep(const void* w,const char* name,int frame,double time,double dt) noexcept {
+ if(!st.enabled||!Owner())return;
+ if(ctx.active){st.faults.fetch_or(Nested);return;}
+ if(!name||std::strcmp(name,st.world))return;
+ const auto step=std::uint64_t(frame)+1;if(step<st.cfg.first||step>st.cfg.last)return;
+ if(st.worldPtr&&st.worldPtr!=w){st.faults.fetch_or(IdentityMismatch);return;}
+ if(st.lastStep&&step!=st.lastStep+1) { st.faults.fetch_or(IdentityMismatch); }
+ st.lastStep=step;
+ st.worldPtr=w;ctx=Context{true,step,0,-1,-1,w};++st.steps;
+ double d[]={double(frame),time,dt,time+dt};Emit("step_begin","World::step",name,d,4);
+}
+void EndStep(bool interrupted) noexcept {if(!Active())return;if(interrupted)st.faults.fetch_or(Interrupted);Scalar("step_end","World::step",interrupted?1:0);ctx=Context{};}
+StepScope::StepScope(const void* w,const char* name,int f,double t,double dt) noexcept:exceptions(std::uncaught_exceptions()),opened(false){const bool before=Active();BeginStep(w,name,f,t,dt);opened=!before&&Active();}
+StepScope::~StepScope() noexcept {if(opened)EndStep(std::uncaught_exceptions()>exceptions);}
+void BeginAssembly(std::size_t n,const char* solver) noexcept {if(!Active())return;ctx.assembly=++st.assemblies;ctx.row=ctx.col=-1;double d=double(n);Emit("assembly_begin","BoxedLcpConstraintSolver",solver,&d,1);}
+void EndAssembly() noexcept {if(!Active())return;Emit("assembly_end","BoxedLcpConstraintSolver","",nullptr,0);ctx.assembly=0;ctx.row=ctx.col=-1;}
+void SetRow(int row,int col,int dimension) noexcept {if(!Active())return;ctx.row=row;ctx.col=col;double d[]={double(row),double(col),double(dimension)};Emit("row_context","BoxedLcpConstraintSolver","",d,3);}
+Status GetStatus() noexcept{return {st.used,st.filled,st.steps,st.assemblies,st.faults.load(),st.enabled,ctx.active};}
+bool FlushExclusive(const char* path) noexcept {
+ if(!st.enabled||ctx.active||!Owner()||!path||!*path)return false;
+ try {
+ std::ostringstream o;o<<"{\"schema_version\":1,\"protocol\":\"DART_INTERNAL_TRACE_V1\",\"run_id\":"<<Json(st.run)<<",\"world\":"<<Json(st.world)<<",\"time_alignment\":\"UNVERIFIED_DART_FRAME_ONLY\",\"stage_b\":\"BLOCKED\",\"first_frame\":"<<st.cfg.first<<",\"last_frame\":"<<st.cfg.last<<",\"steps\":"<<st.steps<<",\"fault_bits\":"<<st.faults.load()<<",\"window_complete\":"<<((st.steps==st.cfg.last-st.cfg.first+1&&!st.faults.load())?"true":"false")<<",\"records\":[";
+ for(std::size_t i=0;i<st.used;++i){const auto& r=st.records[i];if(i)o<<',';o<<"{\"kind\":"<<Json(r.kind)<<",\"source\":"<<Json(r.source)<<",\"identity\":"<<Json(r.identity)<<",\"step\":"<<r.step<<",\"assembly\":"<<r.assembly<<",\"row\":"<<r.row<<",\"column\":"<<r.col<<",\"data_bits\":[";
+ for(std::size_t j=0;j<r.count;++j){std::uint64_t bits=0;std::memcpy(&bits,st.data.data()+r.offset+j,8);if(j)o<<',';o<<'"'<<std::hex<<std::setw(16)<<std::setfill('0')<<bits<<std::dec<<'"';}o<<"]}";}o<<"]}\n";
+ std::string bytes=o.str();int fd=::open(path,O_CREAT|O_EXCL|O_WRONLY|O_NOFOLLOW,0600);if(fd<0){st.faults.fetch_or(IoError);return false;}
+ std::size_t done=0;while(done<bytes.size()){ssize_t n=::write(fd,bytes.data()+done,bytes.size()-done);if(n<0&&errno==EINTR)continue;if(n<=0){st.faults.fetch_or(IoError);::close(fd);return false;}done+=std::size_t(n);}if(::close(fd)){st.faults.fetch_or(IoError);return false;}return true;
+ }catch(...){st.faults.fetch_or(IoError);return false;}
+}
+void FinishWorld(const void* w) noexcept {if(st.enabled&&st.worldPtr==w){const char* p=std::getenv("DART_TRACE_OUTPUT_V1");if(p)FlushExclusive(p);}}
+}}}}
