    "dart/simulation/World.cpp": [
      "--- \n",
      "+++ \n",
      "+#include \"dart/external/odelcpsolver/internal_trace.h\"",
      "+#include \"dart/dynamics/DegreeOfFreedom.hpp\"",
      "+  dart::external::ode::trace::InitializeEnvironment();",
      "+  dart::external::ode::trace::FinishWorld(this);",
      "+  dart::external::ode::trace::StepScope traceScope(this, mName.c_str(), mFrame, mTime, mTimeStep);",
      "+  if (dart::external::ode::trace::Active()) {",
      "+    for (const auto& skel : mSkeletons) {",
      "+      for (std::size_t i=0;i<skel->getNumDofs();++i) {",
      "+        const double values[]={double(i),skel->getVelocity(i)};",
      "+        dart::external::ode::trace::Emit(\"v_free\", \"World::step.after_integrateVelocities\", skel->getName().c_str(),values,2);",
      "+        dart::external::ode::trace::Emit(\"dof_identity\", \"World::step\", skel->getDof(i)->getName().c_str(),values,1);",
      "+      }",
      "+    }",
      "+  }",
      "+  dart::external::ode::trace::Scalar(\"actual_frame_after\",\"World::step\",mFrame);",
      "+  dart::external::ode::trace::Scalar(\"actual_time_after\",\"World::step\",mTime);"
    ],
    "dart/constraint/BoxedLcpConstraintSolver.cpp": [
      "--- \n",
      "+++ \n",
      "+#include \"dart/external/odelcpsolver/internal_trace.h\"",
      "+  if (dart::external::ode::trace::Active())",
      "+    dart::external::ode::trace::BeginAssembly(n,mBoxedLcpSolver->getType().c_str());",
      "+    dart::external::ode::trace::SetRow(int(mOffset[i]),int(i),int(constraint->getDimension()));",
      "+    if (dart::external::ode::trace::Active())",
      "+      dart::external::ode::trace::Emit(\"constraint_type\",\"BoxedLcpConstraintSolver\",constraint->getType().c_str(),nullptr,0);",
      "+  if (dart::external::ode::trace::Active()) {",
      "+    dart::external::ode::trace::Matrix(\"A0\",\"BoxedLcpConstraintSolver.before_primary\",mA.data(),int(n),nSkip);",
      "+    dart::external::ode::trace::Emit(\"b0\",\"BoxedLcpConstraintSolver.before_primary\",\"row_velocity\",mB.data(),n);",
      "+    dart::external::ode::trace::Emit(\"x0\",\"BoxedLcpConstraintSolver.before_primary\",\"row_impulse\",mX.data(),n);",
      "+    dart::external::ode::trace::Emit(\"lo0\",\"BoxedLcpConstraintSolver.before_primary\",\"mixed_initial_bounds\",mLo.data(),n);",
      "+    dart::external::ode::trace::Emit(\"hi0\",\"BoxedLcpConstraintSolver.before_primary\",\"mixed_initial_bounds\",mHi.data(),n);",
      "+    dart::external::ode::trace::Integers(\"findex0\",\"BoxedLcpConstraintSolver.before_primary\",mFIndex.data(),n);",
      "+    dart::external::ode::trace::Integers(\"offsets\",\"BoxedLcpConstraintSolver.before_primary\",mOffset.data(),numConstraints);",
      "+  }",
      "+  dart::external::ode::trace::Scalar(\"primary_raw_return\",\"BoxedLcpConstraintSolver\",success);",
      "+  if (dart::external::ode::trace::Active()) dart::external::ode::trace::Scalar(\"primary_has_nan\",\"BoxedLcpConstraintSolver\",mX.hasNaN());",
      "+  dart::external::ode::trace::Scalar(\"primary_effective_success\",\"BoxedLcpConstraintSolver\",success);",
      "+  dart::external::ode::trace::Scalar(\"fallback_called\",\"BoxedLcpConstraintSolver\",!success && bool(mSecondaryBoxedLcpSolver));",
      "-    mSecondaryBoxedLcpSolver->solve(",
      "+    if (dart::external::ode::trace::Active())",
      "+      dart::external::ode::trace::Emit(\"fallback_type\",\"BoxedLcpConstraintSolver\",mSecondaryBoxedLcpSolver->getType().c_str(),nullptr,0);",
      "+    const bool traceFallbackReturn = mSecondaryBoxedLcpSolver->solve(",
      "+    dart::external::ode::trace::Scalar(\"fallback_raw_return\",\"BoxedLcpConstraintSolver\",traceFallbackReturn);",
      "+  dart::external::ode::trace::Emit(\"selected_x_before_repair\",\"BoxedLcpConstraintSolver\",\"caller_row_order; inspect failure mapping\",mX.data(),n);",
      "+  if (dart::external::ode::trace::Active()) dart::external::ode::trace::Scalar(\"nan_repair_required\",\"BoxedLcpConstraintSolver\",mX.hasNaN());",
      "+  dart::external::ode::trace::Emit(\"final_x\",\"BoxedLcpConstraintSolver\",\"caller_row_order; inspect failure mapping\",mX.data(),n);",
      "+    dart::external::ode::trace::SetRow(int(mOffset[i]),int(i),int(constraint->getDimension()));",
      "+  dart::external::ode::trace::EndAssembly();"
    ],
    "dart/constraint/ContactConstraint.cpp": [
      "--- \n",
      "+++ \n",
      "+#include \"dart/external/odelcpsolver/internal_trace.h\"",
      "+  if (dart::external::ode::trace::Active()) {",
      "+    dart::external::ode::trace::Emit(\"contact_identity\",\"ContactConstraint::getInformation\",mBodyNodeA->getName().c_str(),nullptr,0);",
      "+    dart::external::ode::trace::Emit(\"contact_skeletonA\",\"ContactConstraint::getInformation\",mBodyNodeA->getSkeleton()->getName().c_str(),nullptr,0);",
      "+    dart::external::ode::trace::Emit(\"contact_skeletonB\",\"ContactConstraint::getInformation\",mBodyNodeB->getSkeleton()->getName().c_str(),nullptr,0);",
      "+    dart::external::ode::trace::Emit(\"contact_bodyB\",\"ContactConstraint::getInformation\",mBodyNodeB->getName().c_str(),nullptr,0);",
      "+    dart::external::ode::trace::Emit(\"contact_shapeA\",\"ContactConstraint::getInformation\",mContact.collisionObject1->getShapeFrame()->getName().c_str(),nullptr,0);",
      "+    dart::external::ode::trace::Emit(\"contact_shapeB\",\"ContactConstraint::getInformation\",mContact.collisionObject2->getShapeFrame()->getName().c_str(),nullptr,0);",
      "+    dart::external::ode::trace::Emit(\"contact_point\",\"ContactConstraint::getInformation\",\"world_m\",mContact.point.data(),3);",
      "+    dart::external::ode::trace::Emit(\"contact_normal\",\"ContactConstraint::getInformation\",\"world\",mContact.normal.data(),3);",
      "+    const double params[]={mContact.penetrationDepth,mPrimaryFrictionCoeff,mSecondaryFrictionCoeff,mErrorAllowance,mErrorReductionParameter,mConstraintForceMixing,mPrimarySlipCompliance,mSecondarySlipCompliance,mRestitutionCoeff,mMaxErrorReductionVelocity,double(mDim)};",
      "+    dart::external::ode::trace::Emit(\"contact_parameters\",\"ContactConstraint::getInformation\",\"depth,mu1,mu2,allowance,erp,cfm,slip1,slip2,restitution,max_erv,dim\",params,11);",
      "+    for (std::size_t col=0;col<mDim;++col) {",
      "+      dart::external::ode::trace::Emit(\"jacobian_A\",\"ContactConstraint::getInformation\",\"local_angular_linear\",mSpatialNormalA.col(col).data(),6,-1,int(col));",
      "+      dart::external::ode::trace::Emit(\"jacobian_B\",\"ContactConstraint::getInformation\",\"local_angular_linear\",mSpatialNormalB.col(col).data(),6,-1,int(col));",
      "+    }",
      "+    dart::external::ode::trace::Emit(\"contact_relative_free_velocity\",\"ContactConstraint::getInformation\",\"negative_relative_projection\",info->b,mDim);",
      "+  }",
      "+  dart::external::ode::trace::Emit(\"applied_contact_impulse\",\"ContactConstraint::applyImpulse\",\"normal_then_tangents_Ns\",lambda,mDim);"
    ],
