include_guard(GLOBAL)
function(aero_export_current)
  get_property(_targets DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(_imports DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" PROPERTY IMPORTED_TARGETS)
  foreach(_t IN LISTS _targets _imports)
    string(REPLACE "::" "__" _slug "${_t}")
    string(MD5 _scope "${CMAKE_CURRENT_SOURCE_DIR}")
    set(_out "${PROJECT_BINARY_DIR}/joint-targets/${_scope}/${_slug}")
    foreach(_p INTERFACE_INCLUDE_DIRECTORIES INCLUDE_DIRECTORIES INTERFACE_LINK_LIBRARIES LINK_LIBRARIES IMPORTED_LOCATION IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_RELWITHDEBINFO IMPORTED_LOCATION_NOCONFIG COMPILE_DEFINITIONS INTERFACE_COMPILE_DEFINITIONS COMPILE_OPTIONS INTERFACE_COMPILE_OPTIONS)
      get_target_property(_value ${_t} ${_p})
      if(_value AND NOT _value MATCHES "-NOTFOUND$")
        file(WRITE "${_out}/${_p}.txt" "${_value}\n")
      else()
        file(WRITE "${_out}/${_p}.txt" "\n")
      endif()
    endforeach()
    file(WRITE "${_out}/target.txt" "${_t}\n")
  endforeach()
  string(MD5 _scope "${CMAKE_CURRENT_SOURCE_DIR}")
  file(WRITE "${CMAKE_BINARY_DIR}/joint-scopes/${_scope}.txt" "${CMAKE_CURRENT_SOURCE_DIR}\n")
endfunction()
